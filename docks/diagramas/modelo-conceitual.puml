
@startuml
title Modelo conceitual — entidades de domínio

left to right direction
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor white
  BorderColor #5D2B86
  HeaderBackgroundColor #5D2B86
  FontColor #222222
  HeaderFontColor white
}
skinparam ArrowColor #5D2B86

class Proprietario {
  id
  nome
  celular
  observacoes
}

class Cachorro {
  id
  nome
  raca
  porte
  pelagem
  observacoes
}

class Servico {
  id
  nome
  descricao
  preco
}

class Agendamento {
  id
  data
  hora
  status
  observacoes
}

Proprietario "1" -- "0..*" Cachorro : possui
Cachorro "1" -- "0..*" Agendamento : recebe
Servico "1" -- "0..*" Agendamento : associado a

legend bottom
  Status: agendado, andamento,
  concluido ou cancelado.
endlegend

@enduml
