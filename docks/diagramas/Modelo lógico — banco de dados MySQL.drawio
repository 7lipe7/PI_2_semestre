        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Modelo lógico — banco de dados MySQL\n\nhide methods\nhide stereotypes\nskinparam shadowing false\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\n\nskinparam entity {\n  BackgroundColor white\n  BorderColor #5D2B86\n  FontColor #222222\n}\nskinparam ArrowColor #5D2B86\n\nentity proprietarios {\n  * id : INT UNSIGNED &lt;&lt;PK&gt;&gt;\n  --\n  * nome : VARCHAR(120)\n  * celular : VARCHAR(20)\n  observacoes : TEXT NULL\n  * criado_em : TIMESTAMP\n  * atualizado_em : TIMESTAMP\n}\n\nentity cachorros {\n  * id : INT UNSIGNED &lt;&lt;PK&gt;&gt;\n  --\n  * proprietario_id : INT UNSIGNED &lt;&lt;FK&gt;&gt;\n  * nome : VARCHAR(80)\n  raca : VARCHAR(80) NULL\n  porte : ENUM NULL\n  pelagem : VARCHAR(80) NULL\n  observacoes : TEXT NULL\n  * criado_em : TIMESTAMP\n  * atualizado_em : TIMESTAMP\n}\n\nentity servicos {\n  * id : INT UNSIGNED &lt;&lt;PK&gt;&gt;\n  --\n  * nome : VARCHAR(80)\n  descricao : VARCHAR(255) NULL\n  * preco : DECIMAL(10,2)\n  * ativo : TINYINT(1)\n  * criado_em : TIMESTAMP\n  * atualizado_em : TIMESTAMP\n}\n\nentity agendamentos {\n  * id : INT UNSIGNED &lt;&lt;PK&gt;&gt;\n  --\n  * cachorro_id : INT UNSIGNED &lt;&lt;FK&gt;&gt;\n  * servico_id : INT UNSIGNED &lt;&lt;FK&gt;&gt;\n  * data : DATE\n  * hora : TIME\n  * status : ENUM\n  observacoes : TEXT NULL\n  * criado_em : TIMESTAMP\n  * atualizado_em : TIMESTAMP\n  --\n  UNIQUE(data, hora)\n}\n\nentity historico_agendamentos {\n  * id : INT UNSIGNED &lt;&lt;PK&gt;&gt;\n  --\n  * agendamento_id : INT UNSIGNED &lt;&lt;FK&gt;&gt;\n  * status_anterior : ENUM\n  * status_novo : ENUM\n  * alterado_em : TIMESTAMP\n}\n\nentity usuarios {\n  * id : INT UNSIGNED &lt;&lt;PK&gt;&gt;\n  --\n  * nome : VARCHAR(120)\n  * login : VARCHAR(60) &lt;&lt;UNIQUE&gt;&gt;\n  * senha_hash : VARCHAR(255)\n  * criado_em : TIMESTAMP\n}\n\nentity login_tentativas {\n  * id : INT UNSIGNED &lt;&lt;PK&gt;&gt;\n  --\n  * login : VARCHAR(60)\n  * ip : VARCHAR(45)\n  * criado_em : TIMESTAMP\n  INDEX(login, ip, criado_em)\n}\n\nproprietarios ||--o{ cachorros : possui\ncachorros ||--o{ agendamentos : recebe\nservicos ||--o{ agendamentos : vinculado a\nagendamentos ||--o{ historico_agendamentos : registra\n\nnote bottom of agendamentos\n  Restrição: UNIQUE(data, hora)\nend note\n\n@enduml\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4OSWq4saKci01jZ99dZ4-138">
