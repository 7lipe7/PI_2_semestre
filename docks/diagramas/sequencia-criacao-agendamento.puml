
@startuml
title Sequência — criação de agendamento

skinparam shadowing false
skinparam sequence {
  ParticipantBorderColor #5D2B86
  ParticipantBackgroundColor #5D2B86
  ParticipantFontColor white
  ArrowColor #444444
}
hide footbox

actor "Funcionário autenticado" as F
boundary "Navegador" as UI
control "Router" as R
control "AgendamentoController" as C
entity "Agendamento" as M
database "MySQL" as DB

F -> UI: Abre formulário de agendamento
UI -> R: GET /agendamentos/novo
R -> C: create()
C --> UI: Exibe formulário

F -> UI: Preenche e envia os dados
UI -> R: POST /agendamentos
R -> C: store()

C -> C: Valida cachorro, serviço, data e hora

alt Dados inválidos
  C --> UI: Reexibe formulário com erro
else Dados válidos
  C -> M: horarioOcupado(data, hora)
  M -> DB: SELECT por data e hora
  DB --> M: Resultado da consulta
  M --> C: Disponibilidade

  alt Horário já ocupado
    C --> UI: Reexibe formulário com mensagem
  else Horário disponível
    C -> M: create(...)
    M -> DB: INSERT em agendamentos
    alt Restrição UNIQUE aceita
      DB --> M: Registro criado
      M --> C: id criado
      C --> UI: Redireciona para /agendamentos
    else Conflito concorrente (uq_agenda_horario)
      DB --> M: Erro de chave duplicada
      M --> C: PDOException
      C --> UI: Reexibe formulário com erro de horário
    end
  end
end

@enduml
