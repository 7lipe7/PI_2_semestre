        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Diagrama de classes — domínio operacional\n\nleft to right direction\nskinparam shadowing false\nskinparam classAttributeIconSize 0\nskinparam class {\n  BackgroundColor white\n  BorderColor #5D2B86\n  HeaderBackgroundColor #5D2B86\n  FontColor #222222\n  HeaderFontColor white\n}\nskinparam ArrowColor #5D2B86\n\nclass Proprietario {\n  id: int\n  nome: string\n  celular: string\n}\n\nclass Cachorro {\n  id: int\n  nome: string\n  raca: string?\n  porte: string?\n  proprietario_id: int\n}\n\nclass Servico {\n  id: int\n  nome: string\n  preco: decimal\n  ativo: boolean\n}\n\nclass Agendamento {\n  id: int\n  data: date\n  hora: time\n  status: string\n  cachorro_id: int\n  servico_id: int\n}\n\nProprietario \&quot;1\&quot; -- \&quot;0..*\&quot; Cachorro : possui\nCachorro \&quot;1\&quot; -- \&quot;0..*\&quot; Agendamento : recebe\nServico \&quot;1\&quot; -- \&quot;0..*\&quot; Agendamento : corresponde a\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4OSWq4saKci01jZ99dZ4-29">
