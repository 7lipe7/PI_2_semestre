        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Sistema Amora Banho e Tosa — Casos de Uso\n\nleft to right direction\nskinparam shadowing false\nskinparam packageStyle rectangle\nskinparam usecase {\n  BackgroundColor #EFE6F5\n  BorderColor #5D2B86\n}\nskinparam package {\n  BorderColor #5D2B86\n  FontColor #5D2B86\n}\n\nactor \&quot;Funcionário\&quot; as F\n\nrectangle \&quot;Sistema Amora Banho e Tosa\&quot; {\n  usecase \&quot;Autenticar-se\&quot; as Auth\n  usecase \&quot;Consultar agenda\\ndo dia\&quot; as Agenda\n  usecase \&quot;Gerenciar\\nproprietários\&quot; as Proprietarios\n  usecase \&quot;Gerenciar\\ncachorros\&quot; as Cachorros\n  usecase \&quot;Gerenciar\\nagendamentos\&quot; as Agendamentos\n  usecase \&quot;Alterar status\\ndo agendamento\&quot; as Status\n  usecase \&quot;Gerenciar\\nserviços\&quot; as Servicos\n  usecase \&quot;Encerrar sessão\&quot; as Sair\n}\n\nF -- Auth\nF -- Agenda\nF -- Proprietarios\nF -- Cachorros\nF -- Agendamentos\nF -- Status\nF -- Servicos\nF -- Sair\n\nnote bottom of Status\n  Agendado, em andamento,\n  concluído ou cancelado.\nend note\n\n@enduml\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4OSWq4saKci01jZ99dZ4-2">
