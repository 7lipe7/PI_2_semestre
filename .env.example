# Copie este arquivo para .env e ajuste os valores conforme necessário
# no arquivo criar o arquivo  .env na raiz do projeto 

DB_HOST=db
DB_PORT=3306
DB_NAME=petshop
DB_USER=petshop_user
DB_PASSWORD=petshop_pass
DB_ROOT_PASSWORD=petshop_root

# Opcional; quando preenchida, prevalece sobre DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
# Exemplo para banco remoto com TLS obrigatório:
# DATABASE_URL=mysql://usuario:senha@host:porta/banco?ssl-mode=REQUIRED
